{
  "name": "uruflow-frontend",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests public/theme.js vite.config.ts index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests public/theme.js vite.config.ts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
